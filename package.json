{
  "name": "atomax-media-office",
  "productName": "Atomax Media Office",
  "version": "1.0.10",
  "description": "3D AI media office that writes Atomax social posts with per-platform agents (Claude, OpenAI, Higgsfield)",
  "main": "src/main.js",
  "author": "Tom Mira",
  "license": "UNLICENSED",
  "private": true,
  "repository": "github:tomosmira823-wq/atomax-media",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "three": "^0.170.0"
  },
  "build": {
    "appId": "uk.atomax.mediaoffice",
    "productName": "Atomax Media Office",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "AtomaxMediaOffice-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "tomosmira823-wq",
      "repo": "atomax-media",
      "releaseType": "release"
    }
  }
}
